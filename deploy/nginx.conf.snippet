# Alternativa a Caddy si el VPS ya usa nginx (certificados con certbot).
# Incluir dentro de http { } o en /etc/nginx/sites-available/consulta.legal-ia.co
server {
    listen 443 ssl http2;
    server_name consulta.legal-ia.co;

    ssl_certificate     /etc/letsencrypt/live/consulta.legal-ia.co/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/consulta.legal-ia.co/privkey.pem;

    client_max_body_size 16k;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 95s;   # > timeout del scraper (75 s), < timeout cliente (90 s) + margen
        proxy_send_timeout 95s;
    }
}

server {
    listen 80;
    server_name consulta.legal-ia.co;
    return 301 https://$host$request_uri;
}
