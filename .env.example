# Claves Bearer separadas por coma. Prefijos obligatorios: web_ (legal-ia.co) y desktop_ (Legal-IA Desktop).
# En producción: generar con `python -c "import secrets;print('web_'+secrets.token_urlsafe(32))"`
TOOL_API_KEYS=web_dev,desktop_dev

# Cache de resultados (segundos). Rango recomendado 300–900.
CACHE_TTL_SECONDS=600

# Presupuesto de tiempo del scraper (debe ser < timeout del cliente, 90 s).
SCRAPER_TIMEOUT_SECONDS=75

# Navegadores Chromium simultáneos.
MAX_CONCURRENT_QUERIES=2

# Máximo de actuaciones devueltas al chat (las más recientes).
MAX_ACTUACIONES=30

STORE_DIR=store
HEADLESS=true
LOG_LEVEL=INFO

# Dominio público (Caddy)
PUBLIC_DOMAIN=consulta.legal-ia.co
